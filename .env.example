# 이 파일을 .env로 복사한 뒤 실제 키 값을 채워 넣으세요.
# cp .env.example .env
#
# .env는 .gitignore에 등록되어 있어 git에 올라가지 않습니다.
# 이 .env.example 파일에는 절대 실제 키 값을 넣지 마세요.

MINDLOGIC_API_KEY=your_key_here

# LangSmith (선택) - https://smith.langchain.com
# 모든 gateway_chat_completion 호출(Phase1 추출/분류, Phase2 행동/Tier2 심판)이
# 개별 run으로 기록된다. LANGSMITH_TRACING이 true가 아니면 추적은 비활성화(no-op)된다.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=snca-pilot
